{
  "name": "mineflayer",
  "version": "4.39.0",
  "description": "create minecraft bots with a stable, high level API",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "docs/",
    "examples/",
    "LICENSE"
  ],
  "scripts": {
    "mocha_test": "mocha --reporter ./test/common/durationsReporter.js --exit",
    "test": "bun run --parallel --no-exit-on-error lint test:unit test:types && node test/run-versions.js",
    "test:unit": "node test/run-unit.js",
    "test:types": "bun check",
    "test:versions": "node test/run-versions.js",
    "lint": "bun run --parallel --no-exit-on-error lint:js lint:md",
    "lint:js": "standard",
    "lint:md": "standard-markdown",
    "fix": "standard --fix && standard-markdown --fix",
    "prepublishOnly": "cp docs/README.md README.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HYPExMon5ter/mineflayer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "minecraft-data": "https://github.com/HYPExMon5ter/node-minecraft-data/releases/download/java-26.3-data-12/minecraft-data-3.117.0.tgz",
    "minecraft-protocol": "git+https://github.com/HYPExMon5ter/node-minecraft-protocol.git#bedb4f9f8022f0becd305080560581e5a6cfd002",
    "mojangson": "^2.0.4",
    "prismarine-biome": "^1.1.1",
    "prismarine-block": "^1.22.0",
    "prismarine-chat": "^1.7.1",
    "prismarine-chunk": "git+https://github.com/HYPExMon5ter/prismarine-chunk.git#d6970406728858f8f7481cab174f3be9c1d867c5",
    "prismarine-entity": "^2.5.0",
    "prismarine-item": "git+https://github.com/HYPExMon5ter/prismarine-item.git#ccd339df9ac2f5818c0691f6c0ae641eea90d0d7",
    "prismarine-nbt": "^2.0.0",
    "prismarine-physics": "git+https://github.com/HYPExMon5ter/prismarine-physics.git#4edde73ad65af442dbdf5112495eb9022a321e16",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.10.0",
    "prismarine-windows": "^2.9.0",
    "prismarine-world": "^3.6.0",
    "protodef": "^1.18.0",
    "typed-emitter": "^1.0.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.7"
  },
  "overrides": {
    "minecraft-data": "$minecraft-data",
    "prismarine-chunk": "$prismarine-chunk",
    "prismarine-item": "$prismarine-item",
    "prismarine-physics": "$prismarine-physics"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "doctoc": "^2.0.1",
    "minecraft-wrap": "^1.3.0",
    "mineflayer": "./",
    "mocha": "^11.0.1",
    "protodef-yaml": "^1.5.3",
    "standard": "^17.0.0",
    "standard-markdown": "^7.1.0"
  }
}
