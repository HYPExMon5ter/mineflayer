{
  "name": "mineflayer",
  "version": "4.39.0",
  "description": "create minecraft bots with a stable, high level API",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "docs/",
    "examples/",
    "LICENSE"
  ],
  "scripts": {
    "mocha_test": "mocha --reporter ./test/common/durationsReporter.js --exit",
    "test": "npm run mocha_test",
    "test:unit": "node test/run-unit.js",
    "test:types": "tsc --noEmit --strict --skipLibCheck --esModuleInterop --target ES2022 --module commonjs test/types.ts",
    "pretest": "npm run lint",
    "lint": "standard && standard-markdown",
    "fix": "standard --fix && standard-markdown --fix",
    "prepublishOnly": "cp docs/README.md README.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HYPExMon5ter/mineflayer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "minecraft-data": "https://github.com/HYPExMon5ter/node-minecraft-data/releases/download/java-26.3-data-5/minecraft-data-3.117.0.tgz",
    "minecraft-protocol": "git+https://github.com/HYPExMon5ter/node-minecraft-protocol.git#aea3107ea70c5dbf0799b7c0f8e1d4d520f34509",
    "mojangson": "^2.0.4",
    "prismarine-biome": "^1.1.1",
    "prismarine-block": "^1.22.0",
    "prismarine-chat": "^1.7.1",
    "prismarine-chunk": "git+https://github.com/HYPExMon5ter/prismarine-chunk.git#f462cb49c9dd2b8a4587a31f577ee3a7785f0b8b",
    "prismarine-entity": "^2.5.0",
    "prismarine-item": "git+https://github.com/HYPExMon5ter/prismarine-item.git#7a7b72dc0f86550f66f89a60d60d5cb2800a449f",
    "prismarine-nbt": "^2.0.0",
    "prismarine-physics": "git+https://github.com/HYPExMon5ter/prismarine-physics.git#5d9f493317c2f6dd822b65d71f0dbb99d7e7c85e",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.10.0",
    "prismarine-windows": "^2.9.0",
    "prismarine-world": "^3.6.0",
    "protodef": "^1.18.0",
    "typed-emitter": "^1.0.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.7"
  },
  "overrides": {
    "minecraft-data": "$minecraft-data",
    "prismarine-chunk": "$prismarine-chunk",
    "prismarine-item": "$prismarine-item",
    "prismarine-physics": "$prismarine-physics"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "doctoc": "^2.0.1",
    "minecraft-wrap": "^1.3.0",
    "mineflayer": "./",
    "mocha": "^11.0.1",
    "protodef-yaml": "^1.5.3",
    "standard": "^17.0.0",
    "standard-markdown": "^7.1.0",
    "typescript": "^5.4.5"
  }
}
